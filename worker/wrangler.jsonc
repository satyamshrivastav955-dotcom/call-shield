{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antai-edge-api",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANTAI_HUB",
        "class_name": "AntaiHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AntaiHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
