# antAI hosted-API keys (DEV RIG ONLY — the phone runs fully offline).
# GITIGNORED — do not commit. Rotate after any public demo.
#
# Speech-to-text (replaces faster-whisper on the rig)
DEEPGRAM_API_KEY=
# Synthetic / AI-voice detection (replaces the local SSL ensemble)
VELMA_API_KEY=
# Set this to your Velma REST scoring endpoint, e.g.
#   VELMA_ENDPOINT=https://...
# Leave blank until you have it; voice-deepfake then reports "no signal".
VELMA_ENDPOINT=
# LLM + LangGraph reasoning (replaces the local Qwen GGUF)
GROQ_API_KEY=
# Local storage encryption (replaces "change-me-please" default in config.yaml)
STORAGE_ENCRYPTION_KEY=
# Salt for phone-number hashing (privacy / anonymization requirement)
ANTAI_PHONE_SALT=
