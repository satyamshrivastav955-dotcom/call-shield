<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@color/surface">

    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AntAI.Title" />

    <TextView android:id="@+id/tvHint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="16dp"
        android:textAppearance="@style/TextAppearance.AntAI.Body" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnRecord"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="● Record 5 seconds" android:layout_marginTop="28dp"
        style="@style/Widget.AntAI.BigButton" android:backgroundTint="@color/teal_700" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Use this recording" android:layout_marginTop="12dp"
        style="@style/Widget.AntAI.BigButton" android:visibility="gone" />
</LinearLayout>