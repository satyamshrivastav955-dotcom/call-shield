# Logs & Runtime Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*.log
*.zip
*.tar.gz
/*.png
/add-quatarly-models.ps1
/b.sh

# IDE & Editor files
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node.js & Web
node_modules/
SimpleVideoCallReacJs/build/
SimpleVideoCallReacJs/dist/
SimpleVideoCallBackend/node_modules/
SimpleVideoCallReacJs/node_modules/

# Android & Gradle
.gradle/
.kotlin/
**/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

